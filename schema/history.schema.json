{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-ledger.local/schema/history.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "minLength": 2},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed_at", "kind", "source_url", "billing", "conversion", "note_zh"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "observed_at": {"type": "string", "format": "date"},
          "effective_on": {"type": "string", "format": "date"},
          "retrieved_at": {"type": "string", "format": "date"},
          "kind": {"enum": ["initial", "price_change", "correction", "historical"]},
          "source_url": {"type": "string", "pattern": "^https://"},
          "billing": {"type": "object"},
          "conversion": {"type": "object"},
          "note_zh": {"type": "string", "minLength": 4}
        }
      }
    }
  }
}
