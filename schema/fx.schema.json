{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-ledger.local/schema/fx.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pair",
    "base",
    "quote",
    "rate",
    "rate_date",
    "published_figure",
    "published_unit_zh",
    "rate_type",
    "publisher_zh",
    "method_zh",
    "sources",
    "rounding"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "pair": {"const": "USD/CNY"},
    "base": {"const": "USD"},
    "quote": {"const": "CNY"},
    "rate": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "rate_date": {"type": "string", "format": "date"},
    "published_figure": {"type": "string", "minLength": 1},
    "published_unit_zh": {"type": "string", "minLength": 1},
    "rate_type": {"const": "central_parity"},
    "publisher_zh": {"type": "string", "minLength": 4},
    "method_zh": {"type": "string", "minLength": 20},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_zh", "url"],
        "properties": {
          "title_zh": {"type": "string", "minLength": 2},
          "url": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "decimal_places"],
      "properties": {
        "mode": {"const": "half_up"},
        "decimal_places": {"const": 6}
      }
    }
  }
}
