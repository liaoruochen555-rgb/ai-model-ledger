{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-ledger.local/schema/model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "vendor",
    "api_model_id",
    "display_name_zh",
    "region",
    "status",
    "deployment_zh",
    "modalities",
    "context",
    "billing",
    "conversion",
    "source",
    "verified_at",
    "notes_zh"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$"},
    "vendor": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "api_model_id": {"type": "string", "minLength": 2},
    "display_name_zh": {"type": "string", "minLength": 2},
    "display_name_en": {"type": "string"},
    "family": {"type": "string"},
    "region": {"enum": ["cn", "global"]},
    "status": {"enum": ["active", "deprecated", "retiring", "preview"]},
    "deployment_zh": {"type": "string", "minLength": 4},
    "modalities": {"$ref": "#/$defs/modalities"},
    "release": {"$ref": "#/$defs/release"},
    "context": {"$ref": "#/$defs/context"},
    "billing": {"$ref": "#/$defs/billing"},
    "conversion": {"$ref": "#/$defs/conversion"},
    "source": {"$ref": "#/$defs/source"},
    "verified_at": {"type": "string", "format": "date"},
    "notes_zh": {"type": "string", "minLength": 12}
  },
  "$defs": {
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "https": {"type": "string", "pattern": "^https://"},
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["text", "image", "video", "audio", "file"]}
        },
        "output": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["text", "image", "video", "audio"]}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "precision", "kind", "source_url", "note_zh"],
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"},
        "precision": {"enum": ["day", "month"]},
        "kind": {"enum": ["announcement", "default_snapshot", "catalog"]},
        "source_url": {"$ref": "#/$defs/https"},
        "note_zh": {"type": "string", "minLength": 8}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "note_zh"],
      "properties": {
        "window_label": {"type": "string"},
        "window_tokens": {"type": ["integer", "null"], "minimum": 1},
        "window_tokens_exact": {"type": "boolean"},
        "max_output_label": {"type": "string"},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_output_tokens_exact": {"type": "boolean"},
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 1},
        "source_url": {"$ref": "#/$defs/https"},
        "note_zh": {"type": "string", "minLength": 4}
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_zh", "input_per_1m", "output_per_1m", "is_headline"],
      "properties": {
        "id": {"type": "string"},
        "label_zh": {"type": "string", "minLength": 2},
        "applies_when_zh": {"type": "string"},
        "input_per_1m": {"$ref": "#/$defs/money"},
        "output_per_1m": {"$ref": "#/$defs/money"},
        "cache_hit_input_per_1m": {"$ref": "#/$defs/money"},
        "cache_write_5m_per_1m": {"$ref": "#/$defs/money"},
        "cache_write_1h_per_1m": {"$ref": "#/$defs/money"},
        "cache_write_30m_per_1m": {"$ref": "#/$defs/money"},
        "cache_write_12h_per_1m": {"$ref": "#/$defs/money"},
        "list_input_per_1m": {"$ref": "#/$defs/money"},
        "list_output_per_1m": {"$ref": "#/$defs/money"},
        "is_headline": {"type": "boolean"}
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "currency", "price_covers_zh", "headline"],
      "properties": {
        "unit": {"const": "per_1m_tokens"},
        "currency": {"enum": ["CNY", "USD"]},
        "price_covers_zh": {"type": "string", "minLength": 8},
        "headline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label_zh", "input_per_1m", "output_per_1m"],
          "properties": {
            "id": {"type": "string"},
            "label_zh": {"type": "string", "minLength": 2},
            "input_per_1m": {"$ref": "#/$defs/money"},
            "output_per_1m": {"$ref": "#/$defs/money"},
            "cache_hit_input_per_1m": {"$ref": "#/$defs/money"},
            "cache_write_5m_per_1m": {"$ref": "#/$defs/money"},
            "cache_write_1h_per_1m": {"$ref": "#/$defs/money"},
            "cache_write_30m_per_1m": {"$ref": "#/$defs/money"},
            "cache_write_12h_per_1m": {"$ref": "#/$defs/money"}
          }
        },
        "tiers": {"type": "array", "items": {"$ref": "#/$defs/tier"}},
        "scheduled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effective_on", "input_per_1m", "output_per_1m", "note_zh"],
          "properties": {
            "effective_on": {"type": "string", "format": "date"},
            "input_per_1m": {"$ref": "#/$defs/money"},
            "output_per_1m": {"$ref": "#/$defs/money"},
            "cache_hit_input_per_1m": {"$ref": "#/$defs/money"},
            "note_zh": {"type": "string", "minLength": 8}
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label_zh", "discount_rate", "note_zh"],
          "properties": {
            "label_zh": {"type": "string"},
            "discount_rate": {"$ref": "#/$defs/money"},
            "ends_on": {"type": ["string", "null"]},
            "note_zh": {"type": "string", "minLength": 8}
          }
        },
        "alternate_lists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currency", "label_zh", "input_per_1m", "output_per_1m", "source_url", "note_zh"],
            "properties": {
              "currency": {"enum": ["CNY", "USD"]},
              "label_zh": {"type": "string"},
              "input_per_1m": {"$ref": "#/$defs/money"},
              "output_per_1m": {"$ref": "#/$defs/money"},
              "cache_hit_input_per_1m": {"$ref": "#/$defs/money"},
              "source_url": {"$ref": "#/$defs/https"},
              "note_zh": {"type": "string", "minLength": 8}
            }
          }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fx_id", "cny_input_per_1m", "cny_output_per_1m", "usd_input_per_1m", "usd_output_per_1m"],
      "properties": {
        "fx_id": {"type": "string"},
        "cny_input_per_1m": {"$ref": "#/$defs/money"},
        "cny_output_per_1m": {"$ref": "#/$defs/money"},
        "usd_input_per_1m": {"$ref": "#/$defs/money"},
        "usd_output_per_1m": {"$ref": "#/$defs/money"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title_zh", "section_zh", "retrieved_at"],
      "properties": {
        "url": {"$ref": "#/$defs/https"},
        "title_zh": {"type": "string", "minLength": 2},
        "section_zh": {"type": "string", "minLength": 16},
        "retrieved_at": {"type": "string", "format": "date"}
      }
    }
  }
}
